   "source": [
    "## Example usage"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "controller = TrafficFuzzyController()\n",
    "\n",
    "tests = [(5, 1), (20, 4), (45, 8), (45, 1), (5, 9)]\n",
    "for q, w in tests:\n",
    "    print(f\"queue={q:>3}, wait={w:>3} -> green = {controller.compute(q, w):.2f} s\")\n",
    "\n",
    "print(\"Emergency override ->\", controller.compute(20, 4, emergency=True), \"s\")"
   ]
  }
