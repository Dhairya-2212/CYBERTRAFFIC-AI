   "source": [
    "# CYBERTRAFFIC AI Video Analyzer\n",
    "Vehicle detection (MobileNet SSD), centroid tracking, line-crossing count and speed-violation detection using OpenCV.\n",
    "\n",
    "**Requires:** `pip install opencv-python numpy`. Press `q` in the video window to quit."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import time\n",
    "import math\n",
    "import os\n",
    "import urllib.request\n",
    "from collections import OrderedDict\n",
    "\n",
    "# ==========================================\n",
    "# CONFIGURATION & PARAMETERS\n",
    "# ==========================================\n",
    "VIDEO_SOURCE = 0  # 0 for webcam, or provide a path like \"traffic.mp4\"\n",
    "COUNT_LINE_FRAC = 0.6  # Line position at 60% of the frame height\n",
    "PIXELS_PER_METER = 12.0  # Scale for speed estimation\n",
    "SPEED_LIMIT_KMH = 80.0\n",
    "CONFIDENCE_THRESHOLD = 0.5\n",
    "MAX_DISAPPEARED = 15  # Frames to keep a lost track alive\n",
    "\n",
    "# Model URLs (MobileNet SSD trained on COCO/VOC)\n",
    "PROTOTXT_URL = \"https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/voc/MobileNetSSD_deploy.prototxt\"\n",
    "MODEL_URL = \"https://raw.githubusercontent.com/chuanqi305/MobileNet-SSD/master/voc/MobileNetSSD_deploy.caffemodel\"\n",
    "PROTOTXT_FILE = \"MobileNetSSD_deploy.prototxt\"\n",
    "MODEL_FILE = \"MobileNetSSD_deploy.caffemodel\"\n",
    "\n",
    "# Classes the model can detect (we only care about vehicles)\n",
    "CLASSES = [\"background\", \"aeroplane\", \"bicycle\", \"bird\", \"boat\",\n",
    "           \"bottle\", \"bus\", \"car\", \"cat\", \"chair\", \"cow\", \"diningtable\",\n",
    "           \"dog\", \"horse\", \"motorbike\", \"person\", \"pottedplant\", \"sheep\",\n",
    "           \"sofa\", \"train\", \"tvmonitor\"]\n",
    "VEHICLE_CLASSES = {\"car\", \"bus\", \"motorbike\", \"bicycle\"}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model download"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def download_model_files():\n",
    "    \"\"\"Downloads the MobileNet SSD model files if they don't exist locally.\"\"\"\n",
    "    if not os.path.exists(PROTOTXT_FILE):\n",
    "        print(f\"Downloading {PROTOTXT_FILE}...\")\n",
    "        urllib.request.urlretrieve(PROTOTXT_URL, PROTOTXT_FILE)\n",
    "    if not os.path.exists(MODEL_FILE):\n",
    "        print(f\"Downloading {MODEL_FILE}... (This may take a minute)\")\n",
    "        urllib.request.urlretrieve(MODEL_URL, MODEL_FILE)\n",
    "    print(\"Model files ready.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Centroid tracker"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class CentroidTracker:\n",
    "    def __init__(self, max_disappeared=15):\n",
    "        self.next_object_id = 1\n",
    "        self.objects = OrderedDict()\n",
    "        self.disappeared = OrderedDict()\n",
    "        self.max_disappeared = max_disappeared\n",
    "        # Store history to calculate speed and line crossing\n",
    "        self.history = OrderedDict()\n",
    "        self.counted_ids = set()\n",
    "        self.violations = set()\n",
    "\n",
    "    def register(self, centroid, label):\n",
    "        self.objects[self.next_object_id] = centroid\n",
    "        self.disappeared[self.next_object_id] = 0\n",
    "        self.history[self.next_object_id] = [(centroid, time.time())]\n",
    "        self.next_object_id += 1\n",
    "\n",
    "    def deregister(self, object_id):\n",
    "        del self.objects[object_id]\n",
    "        del self.disappeared[object_id]\n",
    "        # Keep history for logs, but remove from active tracking\n",
    "        \n",
    "    def update(self, rects, labels):\n",
    "        if len(rects) == 0:\n",
    "            for object_id in list(self.disappeared.keys()):\n",
    "                self.disappeared[object_id] += 1\n",
    "                if self.disappeared[object_id] > self.max_disappeared:\n",
    "                    self.deregister(object_id)\n",
    "            return self.objects\n",
    "\n",
    "        input_centroids = np.zeros((len(rects), 2), dtype=\"int\")\n",
    "        for (i, (start_x, start_y, end_x, end_y)) in enumerate(rects):\n",
    "            c_x = int((start_x + end_x) / 2.0)\n",
    "            c_y = int((start_y + end_y) / 2.0)\n",
    "            input_centroids[i] = (c_x, c_y)\n",
    "\n",
    "        if len(self.objects) == 0:\n",
    "            for i in range(0, len(input_centroids)):\n",
    "                self.register(input_centroids[i], labels[i])\n",
    "        else:\n",
    "            object_ids = list(self.objects.keys())\n",
    "            object_centroids = list(self.objects.values())\n",
    "\n",
    "            # Calculate Euclidean distances between existing tracks and new detections\n",
    "            D = np.linalg.norm(np.array(object_centroids)[:, np.newaxis] - input_centroids, axis=2)\n",
    "\n",
    "            rows = D.min(axis=1).argsort()\n",
    "            cols = D.argmin(axis=1)[rows]\n",
    "\n",
    "            used_rows = set()\n",
    "            used_cols = set()\n",
    "\n",
    "            for (row, col) in zip(rows, cols):\n",
    "                if row in used_rows or col in used_cols:\n",
    "                    continue\n",
    "                # If distance is too large, it's likely a different object\n",
    "                if D[row, col] > 100:\n",
    "                    continue\n",
    "\n",
    "                object_id = object_ids[row]\n",
    "                self.objects[object_id] = input_centroids[col]\n",
    "                self.disappeared[object_id] = 0\n",
    "                \n",
    "                # Update history\n",
    "                self.history[object_id].append((input_centroids[col], time.time()))\n",
    "                if len(self.history[object_id]) > 30: # Keep last 30 frames\n",
    "                    self.history[object_id].pop(0)\n",
    "\n",
    "                used_rows.add(row)\n",
    "                used_cols.add(col)\n",
    "\n",
    "            unused_rows = set(range(0, D.shape[0])).difference(used_rows)\n",
    "            unused_cols = set(range(0, D.shape[1])).difference(used_cols)\n",
    "\n",
    "            for row in unused_rows:\n",
    "                object_id = object_ids[row]\n",
    "                self.disappeared[object_id] += 1\n",
    "                if self.disappeared[object_id] > self.max_disappeared:\n",
    "                    self.deregister(object_id)\n",
    "\n",
    "            for col in unused_cols:\n",
    "                self.register(input_centroids[col], labels[col])\n",
    "\n",
    "        return self.objects"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Analyzer loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_analyzer():\n",
    "    download_model_files()\n",
    "    \n",
    "    print(\"[INFO] Loading model...\")\n",
    "    net = cv2.dnn.readNetFromCaffe(PROTOTXT_FILE, MODEL_FILE)\n",
    "    \n",
    "    print(f\"[INFO] Opening video source: {VIDEO_SOURCE}\")\n",
    "    vs = cv2.VideoCapture(VIDEO_SOURCE)\n",
    "    \n",
    "    tracker = CentroidTracker(max_disappeared=15)\n",
    "    \n",
    "    total_counted = 0\n",
    "    \n",
    "    while True:\n",
    "        ret, frame = vs.read()\n",
    "        if not ret:\n",
    "            print(\"[INFO] End of stream.\")\n",
    "            break\n",
    "            \n",
    "        # Resize for faster processing\n",
    "        frame = cv2.resize(frame, (960, 540))\n",
    "        (h, w) = frame.shape[:2]\n",
    "        \n",
    "        # Calculate count line Y coordinate\n",
    "        line_y = int(h * COUNT_LINE_FRAC)\n",
    "        \n",
    "        # Draw count line\n",
    "        cv2.line(frame, (0, line_y), (w, line_y), (0, 255, 255), 2)\n",
    "        cv2.putText(frame, f\"COUNT LINE: {total_counted}\", (20, line_y - 10),\n",
    "                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)\n",
    "        \n",
    "        # Forward pass through the network\n",
    "        blob = cv2.dnn.blobFromImage(cv2.resize(frame, (300, 300)), 0.007843, (300, 300), 127.5)\n",
    "        net.setInput(blob)\n",
    "        detections = net.forward()\n",
    "        \n",
    "        rects = []\n",
    "        labels = []\n",
    "        \n",
    "        for i in np.arange(0, detections.shape[2]):\n",
    "            confidence = detections[0, 0, i, 2]\n",
    "            \n",
    "            if confidence > CONFIDENCE_THRESHOLD:\n",
    "                idx = int(detections[0, 0, i, 1])\n",
    "                label = CLASSES[idx]\n",
    "                \n",
    "                if label in VEHICLE_CLASSES:\n",
    "                    box = detections[0, 0, i, 3:7] * np.array([w, h, w, h])\n",
    "                    (startX, startY, endX, endY) = box.astype(\"int\")\n",
    "                    rects.append((startX, startY, endX, endY))\n",
    "                    labels.append(label)\n",
    "                    \n",
    "        # Update tracker\n",
    "        objects = tracker.update(rects, labels)\n",
    "        \n",
    "        for (object_id, centroid) in objects.items():\n",
    "            # Check line crossing for counting\n",
    "            hist = tracker.history[object_id]\n",
    "            if len(hist) > 1 and object_id not in tracker.counted_ids:\n",
    "                prev_y = hist[-2][0][1]\n",
    "                curr_y = centroid[1]\n",
    "                \n",
    "                # Check if it crossed the line (downward or upward)\n",
    "                if (prev_y < line_y and curr_y >= line_y) or (prev_y > line_y and curr_y <= line_y):\n",
    "                    total_counted += 1\n",
    "                    tracker.counted_ids.add(object_id)\n",
    "            \n",
    "            # Calculate Speed (Optical flow estimation)\n",
    "            speed_kmh = 0.0\n",
    "            if len(hist) > 5:\n",
    "                # Compare current position to position 5 frames ago\n",
    "                pt1, t1 = hist[-5]\n",
    "                pt2, t2 = hist[-1]\n",
    "                \n",
    "                time_diff = t2 - t1\n",
    "                if time_diff > 0:\n",
    "                    dist_px = math.hypot(pt2[0] - pt1[0], pt2[1] - pt1[1])\n",
    "                    # distance in meters = distance in pixels / pixels_per_meter\n",
    "                    dist_m = dist_px / PIXELS_PER_METER\n",
    "                    speed_mps = dist_m / time_diff\n",
    "                    speed_kmh = speed_mps * 3.6\n",
    "            \n",
    "            # Check for violation\n",
    "            is_speeding = speed_kmh > SPEED_LIMIT_KMH\n",
    "            if is_speeding and object_id not in tracker.violations:\n",
    "                tracker.violations.add(object_id)\n",
    "                print(f\"[VIOLATION] Vehicle #{object_id} speeding at {speed_kmh:.1f} km/h!\")\n",
    "\n",
    "            # Determine bounding box color\n",
    "            color = (0, 0, 255) if is_speeding else (0, 255, 0) # Red if speeding, Green otherwise\n",
    "            \n",
    "            # Draw tracking ID, Centroid, and Speed\n",
    "            text = f\"ID:{object_id} {speed_kmh:.1f}km/h\"\n",
    "            cv2.circle(frame, (centroid[0], centroid[1]), 4, color, -1)\n",
    "            cv2.putText(frame, text, (centroid[0] - 10, centroid[1] - 10),\n",
    "                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)\n",
    "                        \n",
    "            # Draw trail\n",
    "            for j in range(1, len(hist)):\n",
    "                cv2.line(frame, tuple(hist[j-1][0]), tuple(hist[j][0]), color, 2)\n",
    "\n",
    "        # Draw HUD stats\n",
    "        cv2.rectangle(frame, (0, 0), (300, 100), (0, 0, 0), -1)\n",
    "        cv2.putText(frame, f\"Total Count: {total_counted}\", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)\n",
    "        cv2.putText(frame, f\"Speed Violations: {len(tracker.violations)}\", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)\n",
    "        cv2.putText(frame, f\"Limit: {SPEED_LIMIT_KMH} km/h\", (10, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)\n",
    "\n",
    "        cv2.imshow(\"CYBERTRAFFIC AI Video Analyzer (Python/OpenCV)\", frame)\n",
    "        \n",
    "        # Press 'q' to quit\n",
    "        if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "            break\n",
    "            \n",
    "    vs.release()\n",
    "    cv2.destroyAllWindows()"
   ]
  },
